# Copy to .env and fill in the keys you have. Missing keys are fine: that provider is skipped.
# Gemini (needed for Google Search grounding): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq fast chat fallback: https://console.groq.com/keys
GROQ_API_KEY=
# OpenRouter free-model fallback: https://openrouter.ai/keys
OPENROUTER_API_KEY=
